@*
    _ViewStart.cshtml - se ejecuta ANTES de cada vista.
    Establece que TODAS las vistas usen _Layout.cshtml como plantilla base.
    Si una vista necesita un layout diferente, puede sobreescribirlo con:
    @{ Layout = "~/Views/Shared/OtroLayout.cshtml"; }
    O si no necesita layout: @{ Layout = null; }
*@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

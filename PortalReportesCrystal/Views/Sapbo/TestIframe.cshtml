@{
    ViewBag.Title = "Test iframe SAP BO";
    string urlPrueba = (string)ViewBag.UrlPrueba ?? "";
}

<h2>Diagnóstico de embed SAP BO en iframe</h2>

<p>Esta página intenta cargar el servidor SAP BO dentro de un iframe y determina si el embed directo funciona
o si se necesita activar el proxy interno.</p>

<div style="background:#F5F5F5;padding:12px;border-radius:4px;margin-bottom:12px;font-family:monospace;font-size:12px;word-break:break-all;">
    <strong>URL de prueba:</strong><br>
    @urlPrueba
</div>

<div id="resultado" style="padding:12px;margin-bottom:12px;border-radius:4px;border:1px solid #ccc;">
    <em>Cargando iframe... espera hasta 20 segundos.</em>
</div>

<div style="border:1px solid #ccc;border-radius:4px;overflow:hidden;">
    <iframe id="frameTest"
            src="@urlPrueba"
            style="width:100%;height:600px;border:0;display:block;"
            sandbox="allow-scripts allow-same-origin allow-forms">
    </iframe>
</div>

<script>
    (function () {
        var iframe = document.getElementById('frameTest');
        var resultado = document.getElementById('resultado');
        var loaded = false;
        var mostrar = function (estado, msg) {
            var color = estado === 'ok' ? '#4CAF50' : (estado === 'warn' ? '#FF9800' : '#F44336');
            resultado.style.borderColor = color;
            resultado.style.background = estado === 'ok' ? '#E8F5E9' : (estado === 'warn' ? '#FFF3E0' : '#FFEBEE');
            resultado.innerHTML = '<strong style="color:' + color + ';">' + estado.toUpperCase() + ':</strong> ' + msg;
            // Notificar al servidor
            fetch('@Url.Action("RegistrarDiagnosticoIframe", "Auditoria")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ estado: estado, mensaje: msg, url: '@urlPrueba' })
            }).catch(function () {});
        };

        iframe.addEventListener('load', function () {
            loaded = true;
            try {
                var doc = iframe.contentDocument || iframe.contentWindow.document;
                if (!doc || !doc.body || doc.body.innerHTML.length === 0) {
                    mostrar('error', 'El iframe cargó pero está en blanco. Probablemente X-Frame-Options=DENY. Se requiere proxy interno.');
                } else {
                    mostrar('ok', 'El iframe cargó correctamente. Embed directo funciona.');
                }
            } catch (e) {
                mostrar('ok', 'El iframe cargó (cross-origin, no inspecccionable). Asumiendo embed directo OK.');
            }
        });

        setTimeout(function () {
            if (!loaded) {
                mostrar('warn', 'El iframe no cargó en 20 segundos. El servidor no responde o bloquea el request.');
            }
        }, 20000);
    })();
</script>

@{
    ViewBag.Title = "Auditoría";
}

<div class="cabecera-listado">
    <h1>Panel de Auditoría</h1>
    <p class="subtitulo">Registros de uso del portal · fuente: <code>DWH_FRAMEWORK.audit</code></p>
</div>

<div class="aviso" style="background:#FFF8E1;color:#7d5b00;border:1px solid #F0C36D;border-radius:4px;padding:12px;margin-bottom:16px;">
    <strong>Panel en construcción.</strong>
    Los datos se poblarán una vez ejecutado <code>Database\audit_schema.sql</code> en Perseo/DWH_FRAMEWORK
    y habilitada la clave <code>Audit:Habilitado=true</code> en <code>Web.config</code>.
</div>

<div class="dashboard-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-bottom:24px;">

    <div class="card" style="background:var(--sr-blanco);border:1px solid var(--sr-borde);border-radius:4px;padding:14px;box-shadow:0 1px 3px rgba(0,0,0,.05);">
        <h3 style="margin:0 0 8px 0;color:var(--sr-primario);">Últimas 24 h</h3>
        <p style="margin:4px 0;"><strong>Sesiones únicas:</strong> <span data-metric="sesiones_24h">—</span></p>
        <p style="margin:4px 0;"><strong>Eventos totales:</strong> <span data-metric="eventos_24h">—</span></p>
        <p style="margin:4px 0;"><strong>Exportaciones:</strong> <span data-metric="exportaciones_24h">—</span></p>
    </div>

    <div class="card" style="background:var(--sr-blanco);border:1px solid var(--sr-borde);border-radius:4px;padding:14px;box-shadow:0 1px 3px rgba(0,0,0,.05);">
        <h3 style="margin:0 0 8px 0;color:var(--sr-primario);">Últimos 30 días</h3>
        <p style="margin:4px 0;"><strong>Sesiones:</strong> <span data-metric="sesiones_30d">—</span></p>
        <p style="margin:4px 0;"><strong>Usuarios únicos:</strong> <span data-metric="usuarios_30d">—</span></p>
        <p style="margin:4px 0;"><strong>Reportes distintos:</strong> <span data-metric="reportes_30d">—</span></p>
    </div>

    <div class="card" style="background:var(--sr-blanco);border:1px solid var(--sr-borde);border-radius:4px;padding:14px;box-shadow:0 1px 3px rgba(0,0,0,.05);">
        <h3 style="margin:0 0 8px 0;color:var(--sr-primario);">Top 10 reportes (30 d)</h3>
        <ol id="top-reportes" style="margin:0;padding-left:20px;font-size:13px;color:var(--sr-texto-sec);">
            <li>Pendiente de datos</li>
        </ol>
    </div>

    <div class="card" style="background:var(--sr-blanco);border:1px solid var(--sr-borde);border-radius:4px;padding:14px;box-shadow:0 1px 3px rgba(0,0,0,.05);">
        <h3 style="margin:0 0 8px 0;color:var(--sr-primario);">Top 10 usuarios (30 d)</h3>
        <ol id="top-usuarios" style="margin:0;padding-left:20px;font-size:13px;color:var(--sr-texto-sec);">
            <li>Pendiente de datos</li>
        </ol>
    </div>

    <div class="card" style="background:var(--sr-blanco);border:1px solid var(--sr-borde);border-radius:4px;padding:14px;box-shadow:0 1px 3px rgba(0,0,0,.05);">
        <h3 style="margin:0 0 8px 0;color:var(--sr-primario);">Distribución por hora (24 h)</h3>
        <p style="color:var(--sr-texto-sec);font-size:13px;">Gráfico pendiente. Fuente: <code>audit.Evento</code> agregado por hora.</p>
    </div>

    <div class="card" style="background:var(--sr-blanco);border:1px solid var(--sr-borde);border-radius:4px;padding:14px;box-shadow:0 1px 3px rgba(0,0,0,.05);">
        <h3 style="margin:0 0 8px 0;color:var(--sr-primario);">Errores (24 h)</h3>
        <p style="margin:4px 0;"><strong>Errores de generación:</strong> <span data-metric="errores_24h">—</span></p>
        <p style="margin:4px 0;"><strong>Accesos denegados:</strong> <span data-metric="accesos_denegados_24h">—</span></p>
    </div>

</div>

<p style="color:var(--sr-texto-sec);font-size:12px;text-align:center;">
    Los datos de este panel se agregan diariamente por el job <code>audit_agregacion_diaria.sql</code>
    y respetan la política de retención de <code>audit_purge_job.sql</code>. Todo acceso a este panel
    queda registrado como evento <code>ACCESO_DASHBOARD</code>.
</p>
